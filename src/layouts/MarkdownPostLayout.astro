---
import PostBody from "../components/PostBody.astro";
import PostHeader from "../components/PostHeader.astro";
import BaseLayout from "./BaseLayout.astro";

const { frontmatter, headings = [], readingTime } = Astro.props;

type BlogFM = {
  title: string;
  description: string;
  pubDate?: Date;
  lastModified?: Date;
  authors?: string[];
  image?: { url?: string } | string;
  tags?: string[];
};

const fm = frontmatter as BlogFM;
const ogType = fm.pubDate ? "article" : "website";
const ogImageUrl = typeof fm.image === "string" ? fm.image : fm.image?.url;

// JSON-LD (schema.org) for blog posts
const origin = Astro.site ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, origin).toString();
const authors: string[] = (fm.authors ?? []) as string[];
const datePublishedIso = fm.pubDate
  ? new Date(fm.pubDate).toISOString()
  : undefined;
const dateModifiedIso = fm.lastModified
  ? new Date(fm.lastModified).toISOString()
  : undefined;

const jsonData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: fm.title,
  description: fm.description,
  url: canonical,
  datePublished: datePublishedIso,
  dateModified: dateModifiedIso,
  author: authors.map((name) => ({ "@type": "Person", name })),
  image: ogImageUrl ? [ogImageUrl] : undefined,
};
---

<BaseLayout
  pageTitle={fm.title}
  pageDescription={fm.description}
  ogType={ogType}
  ogImageUrl={ogImageUrl}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonData)} />
  </Fragment>
  <Fragment slot="title"></Fragment>

  <article class="post">
    <PostHeader
      title={fm.title}
      description={fm.description}
      authors={authors}
      pubDate={fm.pubDate}
      lastModified={fm.lastModified}
      readingTime={readingTime}
      tags={fm.tags}
    />

    <PostBody headings={headings}>
      <slot />
    </PostBody>
  </article>
</BaseLayout>
