---
import { Image } from "astro:assets";
import daytrackr from "../assets/daytrackr.png";
import flotrade from "../assets/flotrade.png";
import PostBody from "../components/PostBody.astro";
import PostHeader from "../components/PostHeader.astro";
import * as use from "../components/switch-case";
import BaseLayout from "./BaseLayout.astro";

// Props: frontmatter for a project content entry plus rendered headings
const { frontmatter, headings = [], readingTime } = Astro.props;

// Types reflecting `project` collection in `src/content/config.ts`
type ProjectFM = {
  title: string;
  description: string;
  authors: string[];
  contributors: string[];
  attributes?: string[];
  image?: { url: string; alt: string } | undefined;
};

const fm = frontmatter as ProjectFM;

// Open Graph basics
const ogType = "website";
const ogImageUrl = fm.image?.url;

// Canonical URL
const origin = Astro.site ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, origin).toString();

// JSON-LD for a Project page using schema.org CreativeWork
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: fm.title,
  description: fm.description,
  url: canonical,
  author: fm.authors?.map((name) => ({ "@type": "Person", name })) ?? [],
  contributor:
    fm.contributors?.map((name) => ({ "@type": "Person", name })) ?? [],
  image: ogImageUrl ? [ogImageUrl] : undefined,
};
---

<BaseLayout
  pageTitle={fm.title}
  pageDescription={fm.description}
  ogType={ogType}
  ogImageUrl={ogImageUrl}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <Fragment slot="title"></Fragment>

  <article class="post">
    <PostHeader
      title={fm.title}
      description={fm.description}
      authors={fm.authors}
      contributors={fm.contributors}
      readingTime={readingTime}
      attributes={fm.attributes}
    />

    <use.switch value={fm.title}>
      <use.case slot="FloTrade">
        <Image
          class="post-hero"
          src={flotrade}
          alt="FloTrade logo"
          format="webp"
          height="300"
          quality="mid"
        />
      </use.case>

      <use.case slot="DayTrackr">
        <Image
          class="post-hero"
          src={daytrackr}
          alt="DayTrackr logo"
          format="webp"
          height="300"
          quality="mid"
        />
      </use.case>
    </use.switch>

    <PostBody headings={headings}>
      <slot />
    </PostBody>
  </article>
</BaseLayout>
