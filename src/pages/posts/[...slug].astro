---
import { getEntry } from "astro:content";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";

import MarkdownPostLayout from "../../layouts/MarkdownPostLayout.astro";

dayjs.extend(localizedFormat);

// 1. Get the slug from the incoming server request
const { slug } = Astro.params;

if (slug === undefined) {
  throw new Error("Slug is required");
}

// Permanently redirect retired post slugs to the posts that replaced them
const movedPosts: Record<string, string> = {
  "pelican-in-docker-2026": "setup-pelican-in-docker",
  "update-pelican-in-docker": "setup-pelican-in-docker#updating-pelican",
};

const movedTo = movedPosts[slug.replace(/\/$/, "")];
if (movedTo !== undefined) {
  return Astro.redirect(`/posts/${movedTo}`, 301);
}

// 2. Query for the entry directly using the request slug
const entry = await getEntry("blog", slug);

// 3. Redirect if the entry does not exist
if (entry === undefined) {
  return Astro.redirect("/404");
}

// 4. (Optional) Render the entry to HTML in the template
const { Content } = await entry.render();

const created = dayjs(entry.data.pubDate).format("ll");
const updated = dayjs(entry.data.lastModified).format("ll");
---

<MarkdownPostLayout
  frontmatter={entry.data}
  created={created}
  updated={updated}>
  <Content />
</MarkdownPostLayout>
